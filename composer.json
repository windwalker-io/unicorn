{
    "name": "windwalker/unicorn",
    "description": "RAD Framework for Windwalker",
    "homepage": "https://github.com/ventoviro/unicorn",
    "type": "windwalker-package",
    "license": "MIT",
    "minimum-stability": "beta",
    "authors": [
        {
            "name": "Simon Asika",
            "email": "asika32764@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4.6",
        "windwalker/core": "^4.2",
        "windwalker/language": "^4.2",
        "intervention/image": "^2.5||^3.0",
        "symfony/mime": "^6.0||^7.0||^8.0",
        "spatie/image-optimizer": "^1.8"
    },
    "require-dev": {
        "windwalker/core": "dev-master",
        "windwalker/framework": "4.x-dev",
        "aws/aws-sdk-php": "^3.402",
        "league/flysystem": "^3.36",
        "league/flysystem-aws-s3-v3": "^3.35",
        "phpunit/phpunit": "^13.4",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "prepare-hooks": "git config core.hooksPath .githooks",
        "remove-hooks": "git config --local --unset core.hooksPath"
    },
    "suggest": {
        "league/flysystem": "Install ^2.0 to support flysystem storage",
        "league/flysystem-aws-s3-v3": "^2.0",
        "aws/aws-sdk-php": "^3.181"
    },
    "archive": {
        "exclude": [
            ".github",
            "assets",
            "tests"
        ]
    },
    "autoload": {
        "psr-4": {
            "Unicorn\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Unicorn\\Tests\\": "tests/"
        }
    },
    "extra": {
        "windwalker": {
            "packages": [
                "Unicorn\\UnicornPackage"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
